<!-- ==== المفاتيح ==== -->
<div id="ownerKeys" class="tab-content">
    <h1 class="dashboard-title">
        <span class="ar-text">🔑 إدارة المفاتيح</span>
        <span class="en-text" style="display:none">🔑 Keys Management</span>
    </h1>

    <!-- ==== إحصائيات المفاتيح ==== -->
    <div class="stats-grid" style="margin-bottom:2rem;">
        <div class="stat-card gold">
            <div class="stat-value" id="monthlyAvailable">-</div>
            <div class="stat-label">
                <span class="ar-text">مفاتيح شهرية متاحة</span>
                <span class="en-text" style="display:none">Monthly Available</span>
            </div>
        </div>
        <div class="stat-card gold">
            <div class="stat-value" id="monthlyUsed">-</div>
            <div class="stat-label">
                <span class="ar-text">مفاتيح شهرية مستخدمة</span>
                <span class="en-text" style="display:none">Monthly Used</span>
            </div>
        </div>
        <div class="stat-card gold">
            <div class="stat-value" id="yearlyAvailable">-</div>
            <div class="stat-label">
                <span class="ar-text">مفاتيح سنوية متاحة</span>
                <span class="en-text" style="display:none">Yearly Available</span>
            </div>
        </div>
        <div class="stat-card gold">
            <div class="stat-value" id="yearlyUsed">-</div>
            <div class="stat-label">
                <span class="ar-text">مفاتيح سنوية مستخدمة</span>
                <span class="en-text" style="display:none">Yearly Used</span>
            </div>
        </div>
    </div>

    <!-- ==== إنشاء مفتاح ==== -->
    <div class="card">
        <h3>
            <span class="ar-text">➕ إنشاء مفتاح جديد</span>
            <span class="en-text" style="display:none">➕ Create New Key</span>
        </h3>

        <form id="createKeyForm" class="coupon-form">
            <div class="form-group">
                <label>اسم المفتاح</label>
                <input type="text" name="key" placeholder="FIRST_SERVER" required>
            </div>
            <div class="form-group">
                <label>النوع</label>
                <select name="type" required>
                    <option value="monthly">📅 شهري</option>
                    <option value="yearly">📅 سنوي</option>
                </select>
            </div>
            <div class="form-group">
                <label>المدة (بالأيام)</label>
                <input type="number" name="duration" min="1" placeholder="30" required>
            </div>
            <button type="submit" class="btn btn-primary">🔑 إنشاء المفتاح</button>
        </form>
    </div>

    <!-- ==== الفلتر ==== -->
    <div class="card" style="margin-top:1rem;">
        <div class="form-group">
            <label>🔍 فلتر المفاتيح</label>
            <input type="text" id="keysFilter" placeholder="اكتب للبحث..." oninput="filterKeys(this.value)">
        </div>
    </div>

    <div id="keysList" class="coupons-list" style="margin-top:1rem;"></div>
</div>
