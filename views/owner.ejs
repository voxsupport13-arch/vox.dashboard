    <main class="dashboard-main">
        <!-- ==== إحصائيات البوت ==== -->
        <div id="ownerOverview" class="tab-content active">
            <h1 class="dashboard-title">
                <span class="ar-text">📊 إحصائيات البوت</span>
                <span class="en-text" style="display:none">📊 Bot Statistics</span>
                <span class="es-text" style="display:none">📊 Estadísticas del Bot</span>
                <span class="fr-text" style="display:none">📊 Statistiques du Bot</span>
            </h1>

            <div class="stats-grid">
                <div class="stat-card gold">
                    <div class="stat-value" id="totalServers">-</div>
                    <div class="stat-label">
                        <span class="ar-text">إجمالي السيرفرات</span>
                        <span class="en-text" style="display:none">Total Servers</span>
                        <span class="es-text" style="display:none">Total de Servidores</span>
                        <span class="fr-text" style="display:none">Total des Serveurs</span>
                    </div>
                </div>
                <div class="stat-card gold">
                    <div class="stat-value" id="freeServers">-</div>
                    <div class="stat-label">
                        <span class="ar-text">سيرفرات المجاني</span>
                        <span class="en-text" style="display:none">Free Servers</span>
                        <span class="es-text" style="display:none">Servidores Gratuitos</span>
                        <span class="fr-text" style="display:none">Serveurs Gratuits</span>
                    </div>
                </div>
                <div class="stat-card gold">
                    <div class="stat-value" id="premiumServers">-</div>
                    <div class="stat-label">
                        <span class="ar-text">سيرفرات البريميم</span>
                        <span class="en-text" style="display:none">Premium Servers</span>
                        <span class="es-text" style="display:none">Servidores Premium</span>
                        <span class="fr-text" style="display:none">Serveurs Premium</span>
                    </div>
                </div>
                <div class="stat-card gold">
                    <div class="stat-value" id="totalMembers">-</div>
                    <div class="stat-label">
                        <span class="ar-text">إجمالي الأعضاء</span>
                        <span class="en-text" style="display:none">Total Members</span>
                        <span class="es-text" style="display:none">Total de Miembros</span>
                        <span class="fr-text" style="display:none">Total des Membres</span>
                    </div>
                </div>
                <div class="stat-card gold">
                    <div class="stat-value" id="allOpenTickets">-</div>
                    <div class="stat-label">
                        <span class="ar-text">تذاكر مفتوحة</span>
                        <span class="en-text" style="display:none">Open Tickets</span>
                        <span class="es-text" style="display:none">Tickets Abiertos</span>
                        <span class="fr-text" style="display:none">Tickets Ouverts</span>
                    </div>
                </div>
                <div class="stat-card gold">
                    <div class="stat-value" id="allClosedTickets">-</div>
                    <div class="stat-label">
                        <span class="ar-text">تذاكر مغلقة</span>
                        <span class="en-text" style="display:none">Closed Tickets</span>
                        <span class="es-text" style="display:none">Tickets Cerrados</span>
                        <span class="fr-text" style="display:none">Tickets Fermés</span>
                    </div>
                </div>
                <div class="stat-card gold">
                    <div class="stat-value" id="totalPurchases">-</div>
                    <div class="stat-label">
                        <span class="ar-text">عمليات شراء</span>
                        <span class="en-text" style="display:none">Purchases</span>
                        <span class="es-text" style="display:none">Compras</span>
                        <span class="fr-text" style="display:none">Achats</span>
                    </div>
                </div>
                <div class="stat-card gold">
                    <div class="stat-value" id="pendingReports">-</div>
                    <div class="stat-label">
                        <span class="ar-text">إبلاغات معلقة</span>
                        <span class="en-text" style="display:none">Pending Reports</span>
                        <span class="es-text" style="display:none">Reportes Pendientes</span>
                        <span class="fr-text" style="display:none">Signalements en Attente</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==== إحصائيات الموقع ==== -->
        <div id="ownerSiteStats" class="tab-content">
            <h1 class="dashboard-title">
                <span class="ar-text">🌐 إحصائيات الموقع</span>
                <span class="en-text" style="display:none">🌐 Site Statistics</span>
                <span class="es-text" style="display:none">🌐 Estadísticas del Sitio</span>
                <span class="fr-text" style="display:none">🌐 Statistiques du Site</span>
            </h1>

            <div class="stats-grid">
                <div class="stat-card gold">
                    <div class="stat-value" id="totalUsers">-</div>
                    <div class="stat-label">
                        <span class="ar-text">إجمالي المستخدمين</span>
                        <span class="en-text" style="display:none">Total Users</span>
                        <span class="es-text" style="display:none">Total de Usuarios</span>
                        <span class="fr-text" style="display:none">Total des Utilisateurs</span>
                    </div>
                </div>
                <div class="stat-card gold">
                    <div class="stat-value" id="onlineUsers">-</div>
                    <div class="stat-label">
                        <span class="ar-text">أونلاين حاليًا</span>
                        <span class="en-text" style="display:none">Online Now</span>
                        <span class="es-text" style="display:none">En Línea Ahora</span>
                        <span class="fr-text" style="display:none">En Ligne Maintenant</span>
                    </div>
                </div>
                <div class="stat-card gold">
                    <div class="stat-value" id="todayUsers">-</div>
                    <div class="stat-label">
                        <span class="ar-text">دخلوا اليوم</span>
                        <span class="en-text" style="display:none">Today's Visits</span>
                        <span class="es-text" style="display:none">Visitas de Hoy</span>
                        <span class="fr-text" style="display:none">Visites d'Aujourd'hui</span>
                    </div>
                </div>
                <div class="stat-card gold">
                    <div class="stat-value" id="weekUsers">-</div>
                    <div class="stat-label">
                        <span class="ar-text">دخلوا آخر أسبوع</span>
                        <span class="en-text" style="display:none">This Week</span>
                        <span class="es-text" style="display:none">Esta Semana</span>
                        <span class="fr-text" style="display:none">Cette Semaine</span>
                    </div>
                </div>
            </div>

            <div class="card" style="margin-top:2rem;">
                <h3>
                    <span class="ar-text">📋 آخر المستخدمين</span>
                    <span class="en-text" style="display:none">📋 Recent Users</span>
                    <span class="es-text" style="display:none">📋 Usuarios Recientes</span>
                    <span class="fr-text" style="display:none">📋 Utilisateurs Récents</span>
                </h3>
                <div id="recentUsers" class="users-list">
                    <p class="loading">⏳</p>
                </div>
            </div>
        </div>

        <!-- ==== الإبلاغات ==== -->
        <div id="ownerReports" class="tab-content">
            <h1 class="dashboard-title">
                <span class="ar-text">🚨 الإبلاغات</span>
                <span class="en-text" style="display:none">🚨 Reports</span>
                <span class="es-text" style="display:none">🚨 Reportes</span>
                <span class="fr-text" style="display:none">🚨 Signalements</span>
            </h1>
            <div id="reportsList" class="reports-list">
                <p class="loading">⏳</p>
            </div>
        </div>

        <!-- ==== طلبات الشراء ==== -->
        <div id="ownerPurchases" class="tab-content">
            <h1 class="dashboard-title">
                <span class="ar-text">💰 طلبات الشراء</span>
                <span class="en-text" style="display:none">💰 Purchase Requests</span>
                <span class="es-text" style="display:none">💰 Solicitudes de Compra</span>
                <span class="fr-text" style="display:none">💰 Demandes d'Achat</span>
            </h1>
            <div id="purchasesList" class="purchases-list">
                <p class="loading">⏳</p>
            </div>
        </div>

        <!-- ==== لوج الرفض ==== -->
        <div id="ownerPurchaseLogs" class="tab-content">
            <h1 class="dashboard-title">
                <span class="ar-text">📋 لوج رفض الشراء</span>
                <span class="en-text" style="display:none">📋 Purchase Reject Logs</span>
                <span class="es-text" style="display:none">📋 Registros de Rechazo de Compra</span>
                <span class="fr-text" style="display:none">📋 Journaux de Rejet d'Achat</span>
            </h1>
            <div id="purchaseLogsList" class="purchases-list">
                <p class="loading">⏳</p>
            </div>
        </div>

        <!-- ==== الأكواد ==== -->
        <div id="ownerCoupons" class="tab-content">
            <h1 class="dashboard-title">
                <span class="ar-text">🎟️ أكواد الخصم</span>
                <span class="en-text" style="display:none">🎟️ Coupons</span>
                <span class="es-text" style="display:none">🎟️ Cupones</span>
                <span class="fr-text" style="display:none">🎟️ Coupons</span>
            </h1>

            <div class="card">
                <h3>
                    <span class="ar-text">➕ إنشاء كود جديد</span>
                    <span class="en-text" style="display:none">➕ Create New Coupon</span>
                    <span class="es-text" style="display:none">➕ Crear Nuevo Cupón</span>
                    <span class="fr-text" style="display:none">➕ Créer un Nouveau Coupon</span>
                </h3>

                <form id="createCouponForm" class="coupon-form">
                    <div class="form-group">
                        <label>
                            <span class="ar-text">الكود</span>
                            <span class="en-text" style="display:none">Code</span>
                            <span class="es-text" style="display:none">Código</span>
                            <span class="fr-text" style="display:none">Code</span>
                        </label>
                        <input type="text" name="code" placeholder="VOX50" required>
                    </div>
                    <div class="form-group">
                        <label>
                            <span class="ar-text">نسبة الخصم (%)</span>
                            <span class="en-text" style="display:none">Discount (%)</span>
                            <span class="es-text" style="display:none">Descuento (%)</span>
                            <span class="fr-text" style="display:none">Réduction (%)</span>
                        </label>
                        <input type="number" name="discount" min="1" max="100" placeholder="50" required>
                    </div>
                    <div class="form-group">
                        <label>
                            <span class="ar-text">عدد الاستخدامات</span>
                            <span class="en-text" style="display:none">Max Uses</span>
                            <span class="es-text" style="display:none">Usos Máximos</span>
                            <span class="fr-text" style="display:none">Utilisations Max</span>
                        </label>
                        <input type="number" name="maxUses" min="1" placeholder="10" required>
                    </div>
                    <div class="form-group">
                        <label>
                            <span class="ar-text">تاريخ البدء</span>
                            <span class="en-text" style="display:none">Start Date</span>
                            <span class="es-text" style="display:none">Fecha de Inicio</span>
                            <span class="fr-text" style="display:none">Date de Début</span>
                        </label>
                        <input type="date" name="startDate" required>
                    </div>
                    <div class="form-group">
                        <label>
                            <span class="ar-text">تاريخ الانتهاء</span>
                            <span class="en-text" style="display:none">End Date</span>
                            <span class="es-text" style="display:none">Fecha de Fin</span>
                            <span class="fr-text" style="display:none">Date de Fin</span>
                        </label>
                        <input type="date" name="endDate" required>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <span class="ar-text">🎟️ إنشاء الكود</span>
                        <span class="en-text" style="display:none">🎟️ Create Coupon</span>
                        <span class="es-text" style="display:none">🎟️ Crear Cupón</span>
                        <span class="fr-text" style="display:none">🎟️ Créer le Coupon</span>
                    </button>
                </form>
            </div>

            <div id="couponsList" class="coupons-list"></div>
        </div>

        <!-- ==== الأخبار ==== -->
        <div id="ownerNews" class="tab-content">
            <h1 class="dashboard-title">
                <span class="ar-text">📢 الأخبار</span>
                <span class="en-text" style="display:none">📢 News</span>
                <span class="es-text" style="display:none">📢 Noticias</span>
                <span class="fr-text" style="display:none">📢 Actualités</span>
            </h1>

            <div class="card">
                <h3>
                    <span class="ar-text">➕ إرسال خبر جديد</span>
                    <span class="en-text" style="display:none">➕ Send New News</span>
                    <span class="es-text" style="display:none">➕ Enviar Nueva Noticia</span>
                    <span class="fr-text" style="display:none">➕ Envoyer une Nouvelle Actualité</span>
                </h3>

                <form id="createNewsForm" class="news-form">
                    <div class="form-group">
                        <label>
                            <span class="ar-text">الخبر</span>
                            <span class="en-text" style="display:none">News</span>
                            <span class="es-text" style="display:none">Noticia</span>
                            <span class="fr-text" style="display:none">Actualité</span>
                        </label>
                        <textarea name="content" rows="4" required></textarea>
                    </div>
                    <div class="form-group">
                        <label>
                            <span class="ar-text">المدة (بالساعات)</span>
                            <span class="en-text" style="display:none">Duration (hours)</span>
                            <span class="es-text" style="display:none">Duración (horas)</span>
                            <span class="fr-text" style="display:none">Durée (heures)</span>
                        </label>
                        <input type="number" name="duration" min="1" max="720" placeholder="24" required>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <span class="ar-text">📢 نشر الخبر</span>
                        <span class="en-text" style="display:none">📢 Publish News</span>
                        <span class="es-text" style="display:none">📢 Publicar Noticia</span>
                        <span class="fr-text" style="display:none">📢 Publier l'Actualité</span>
                    </button>
                </form>
            </div>

            <div id="newsList" class="news-list"></div>
        </div>

        <!-- ==== المفاتيح ==== -->
        <div id="ownerKeys" class="tab-content">
            <h1 class="dashboard-title">
                <span class="ar-text">🔑 إدارة المفاتيح</span>
                <span class="en-text" style="display:none">🔑 Keys Management</span>
                <span class="es-text" style="display:none">🔑 Gestión de Claves</span>
                <span class="fr-text" style="display:none">🔑 Gestion des Clés</span>
            </h1>

            <div class="stats-grid" style="margin-bottom:2rem;">
                <div class="stat-card gold">
                    <div class="stat-value" id="monthlyAvailable">-</div>
                    <div class="stat-label">
                        <span class="ar-text">مفاتيح شهرية متاحة</span>
                        <span class="en-text" style="display:none">Monthly Available</span>
                        <span class="es-text" style="display:none">Mensuales Disponibles</span>
                        <span class="fr-text" style="display:none">Mensuelles Disponibles</span>
                    </div>
                </div>
                <div class="stat-card gold">
                    <div class="stat-value" id="monthlyUsed">-</div>
                    <div class="stat-label">
                        <span class="ar-text">مفاتيح شهرية مستخدمة</span>
                        <span class="en-text" style="display:none">Monthly Used</span>
                        <span class="es-text" style="display:none">Mensuales Usadas</span>
                        <span class="fr-text" style="display:none">Mensuelles Utilisées</span>
                    </div>
                </div>
                <div class="stat-card gold">
                    <div class="stat-value" id="yearlyAvailable">-</div>
                    <div class="stat-label">
                        <span class="ar-text">مفاتيح سنوية متاحة</span>
                        <span class="en-text" style="display:none">Yearly Available</span>
                        <span class="es-text" style="display:none">Anuales Disponibles</span>
                        <span class="fr-text" style="display:none">Annuelles Disponibles</span>
                    </div>
                </div>
                <div class="stat-card gold">
                    <div class="stat-value" id="yearlyUsed">-</div>
                    <div class="stat-label">
                        <span class="ar-text">مفاتيح سنوية مستخدمة</span>
                        <span class="en-text" style="display:none">Yearly Used</span>
                        <span class="es-text" style="display:none">Anuales Usadas</span>
                        <span class="fr-text" style="display:none">Annuelles Utilisées</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <h3>
                    <span class="ar-text">➕ إنشاء مفتاح جديد</span>
                    <span class="en-text" style="display:none">➕ Create New Key</span>
                    <span class="es-text" style="display:none">➕ Crear Nueva Clave</span>
                    <span class="fr-text" style="display:none">➕ Créer une Nouvelle Clé</span>
                </h3>

                <form id="createKeyForm" class="coupon-form">
                    <div class="form-group">
                        <label>
                            <span class="ar-text">اسم المفتاح</span>
                            <span class="en-text" style="display:none">Key Name</span>
                            <span class="es-text" style="display:none">Nombre de la Clave</span>
                            <span class="fr-text" style="display:none">Nom de la Clé</span>
                        </label>
                        <input type="text" name="key" placeholder="FIRST_SERVER" required>
                    </div>
                    <div class="form-group">
                        <label>
                            <span class="ar-text">النوع</span>
                            <span class="en-text" style="display:none">Type</span>
                            <span class="es-text" style="display:none">Tipo</span>
                            <span class="fr-text" style="display:none">Type</span>
                        </label>
                        <select name="type" required>
                            <option value="monthly">📅 شهري</option>
                            <option value="yearly">📅 سنوي</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>
                            <span class="ar-text">المدة (بالأيام)</span>
                            <span class="en-text" style="display:none">Duration (days)</span>
                            <span class="es-text" style="display:none">Duración (días)</span>
                            <span class="fr-text" style="display:none">Durée (jours)</span>
                        </label>
                        <input type="number" name="duration" min="1" placeholder="30" required>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <span class="ar-text">🔑 إنشاء المفتاح</span>
                        <span class="en-text" style="display:none">🔑 Create Key</span>
                        <span class="es-text" style="display:none">🔑 Crear Clave</span>
                        <span class="fr-text" style="display:none">🔑 Créer la Clé</span>
                    </button>
                </form>
            </div>

            <div class="card" style="margin-top:1rem;">
                <div class="form-group">
                    <label>
                        <span class="ar-text">🔍 فلتر المفاتيح</span>
                        <span class="en-text" style="display:none">🔍 Filter Keys</span>
                        <span class="es-text" style="display:none">🔍 Filtrar Claves</span>
                        <span class="fr-text" style="display:none">🔍 Filtrer les Clés</span>
                    </label>
                    <input type="text" id="keysFilter" placeholder="Search..." oninput="filterKeys(this.value)">
                </div>
            </div>

            <div id="keysList" class="coupons-list" style="margin-top:1rem;"></div>
        </div>
    </main>
</div>

<!-- ==== Modal تعديل الأخبار ==== -->
<div id="editNewsModal" class="modal" style="display:none;">
    <div class="modal-content">
        <h3 style="color:var(--gold);margin-bottom:1rem;">
            <span class="ar-text">✏️ تعديل الخبر</span>
            <span class="en-text" style="display:none">✏️ Edit News</span>
            <span class="es-text" style="display:none">✏️ Editar Noticia</span>
            <span class="fr-text" style="display:none">✏️ Modifier l'Actualité</span>
        </h3>
        <form id="editNewsForm">
            <input type="hidden" id="editNewsId">
            <div class="form-group">
                <label>
                    <span class="ar-text">الخبر</span>
                    <span class="en-text" style="display:none">News</span>
                    <span class="es-text" style="display:none">Noticia</span>
                    <span class="fr-text" style="display:none">Actualité</span>
                </label>
                <textarea id="editNewsContent" rows="4" required></textarea>
            </div>
            <div class="form-group">
                <label>
                    <span class="ar-text">المدة (بالساعات)</span>
                    <span class="en-text" style="display:none">Duration (hours)</span>
                    <span class="es-text" style="display:none">Duración (horas)</span>
                    <span class="fr-text" style="display:none">Durée (heures)</span>
                </label>
                <input type="number" id="editNewsDuration" min="1" max="720" required>
            </div>
            <div style="display:flex;gap:0.5rem;margin-top:1rem;">
                <button type="submit" class="btn btn-primary" style="flex:1;">
                    <span class="ar-text">💾 حفظ</span>
                    <span class="en-text" style="display:none">💾 Save</span>
                    <span class="es-text" style="display:none">💾 Guardar</span>
                    <span class="fr-text" style="display:none">💾 Enregistrer</span>
                </button>
                <button type="button" class="btn btn-secondary" onclick="closeEditNews()" style="flex:1;">
                    <span class="ar-text">❌ إلغاء</span>
                    <span class="en-text" style="display:none">❌ Cancel</span>
                    <span class="es-text" style="display:none">❌ Cancelar</span>
                    <span class="fr-text" style="display:none">❌ Annuler</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ==== Modal سبب رفض الشراء ==== -->
<div id="rejectPurchaseModal" class="modal" style="display:none;">
    <div class="modal-content" style="border-color:var(--danger);">
        <h3 style="color:var(--danger);margin-bottom:1rem;">
            <span class="ar-text">❌ سبب رفض الشراء</span>
            <span class="en-text" style="display:none">❌ Reject Reason</span>
            <span class="es-text" style="display:none">❌ Razón del Rechazo</span>
            <span class="fr-text" style="display:none">❌ Raison du Rejet</span>
        </h3>
        <form id="rejectPurchaseForm">
            <input type="hidden" id="rejectPurchaseId">
            <div class="form-group">
                <label>
                    <span class="ar-text">سبب الرفض</span>
                    <span class="en-text" style="display:none">Reject Reason</span>
                    <span class="es-text" style="display:none">Razón del Rechazo</span>
                    <span class="fr-text" style="display:none">Raison du Rejet</span>
                </label>
                <textarea id="rejectPurchaseReason" rows="3" required></textarea>
            </div>
            <div style="display:flex;gap:0.5rem;margin-top:1rem;">
                <button type="submit" class="btn btn-danger" style="flex:1;">
                    <span class="ar-text">❌ رفض</span>
                    <span class="en-text" style="display:none">❌ Reject</span>
                    <span class="es-text" style="display:none">❌ Rechazar</span>
                    <span class="fr-text" style="display:none">❌ Rejeter</span>
                </button>
                <button type="button" class="btn btn-secondary" onclick="closeRejectPurchase()" style="flex:1;">
                    <span class="ar-text">إلغاء</span>
                    <span class="en-text" style="display:none">Cancel</span>
                    <span class="es-text" style="display:none">Cancelar</span>
                    <span class="fr-text" style="display:none">Annuler</span>
                </button>
            </div>
        </form>
    </div>
</div>

