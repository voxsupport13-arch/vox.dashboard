<%- include('partials/header', { user, title: 'Dashboard' }) %>

<div class="dashboard-container">
    <aside class="sidebar">
        <div class="sidebar-header">
            <h3>
                <span class="ar-text">لوحة التحكم</span>
                <span class="en-text" style="display:none">Dashboard</span>
                <span class="es-text" style="display:none">Panel</span>
                <span class="fr-text" style="display:none">Tableau de bord</span>
            </h3>

            <% if (hasPremium) { %>
            <div class="bot-type-switcher">
                <label>
                    <span class="ar-text">🤖 البوت:</span>
                    <span class="en-text" style="display:none">🤖 Bot:</span>
                    <span class="es-text" style="display:none">🤖 Bot:</span>
                    <span class="fr-text" style="display:none">🤖 Bot :</span>
                </label>
                <select id="botTypeSwitcher" onchange="switchBotType()">
                    <option value="free" <%= botType === 'free' ? 'selected' : '' %>>🆓 المجاني</option>
                    <option value="premium" <%= botType === 'premium' ? 'selected' : '' %>>💎 البريميم</option>
                </select>
            </div>
            <% } else { %>
            <span class="bot-badge free">🆓</span>
            <% } %>
        </div>

        <nav class="sidebar-nav">
            <a href="#overview" class="sidebar-link active" onclick="switchTab(event, 'overview')">
                <span class="icon">📊</span>
                <span class="ar-text">نظرة عامة</span>
                <span class="en-text" style="display:none">Overview</span>
                <span class="es-text" style="display:none">Resumen</span>
                <span class="fr-text" style="display:none">Aperçu</span>
            </a>
            <a href="#servers" class="sidebar-link" onclick="switchTab(event, 'servers')">
                <span class="icon">🌐</span>
                <span class="ar-text">السيرفرات</span>
                <span class="en-text" style="display:none">Servers</span>
                <span class="es-text" style="display:none">Servidores</span>
                <span class="fr-text" style="display:none">Serveurs</span>
            </a>
            <a href="#tickets" class="sidebar-link" onclick="switchTab(event, 'tickets')">
                <span class="icon">🎫</span>
                <span class="ar-text">التذاكر</span>
                <span class="en-text" style="display:none">Tickets</span>
                <span class="es-text" style="display:none">Tickets</span>
                <span class="fr-text" style="display:none">Tickets</span>
            </a>
            <% if (botType === 'premium') { %>
            <a href="#subscription" class="sidebar-link" onclick="switchTab(event, 'subscription')">
                <span class="icon">💎</span>
                <span class="ar-text">الاشتراك</span>
                <span class="en-text" style="display:none">Subscription</span>
                <span class="es-text" style="display:none">Suscripción</span>
                <span class="fr-text" style="display:none">Abonnement</span>
            </a>
            <% } %>
            <a href="/reports" class="sidebar-link">
                <span class="icon">🚨</span>
                <span class="ar-text">الإبلاغ</span>
                <span class="en-text" style="display:none">Reports</span>
                <span class="es-text" style="display:none">Reportes</span>
                <span class="fr-text" style="display:none">Signalements</span>
            </a>
        </nav>
    </aside>

    <main class="dashboard-main">
        <!-- ==== نظرة عامة ==== -->
        <div id="overview" class="tab-content active">
            <h1 class="dashboard-title">
                <span class="ar-text">📊 نظرة عامة</span>
                <span class="en-text" style="display:none">📊 Overview</span>
                <span class="es-text" style="display:none">📊 Resumen</span>
                <span class="fr-text" style="display:none">📊 Aperçu</span>
            </h1>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-value" id="userServers">-</div>
                    <div class="stat-label">
                        <span class="ar-text">سيرفراتك</span>
                        <span class="en-text" style="display:none">Your Servers</span>
                        <span class="es-text" style="display:none">Tus Servidores</span>
                        <span class="fr-text" style="display:none">Vos Serveurs</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="botServers">-</div>
                    <div class="stat-label">
                        <span class="ar-text">السيرفرات المشتركة</span>
                        <span class="en-text" style="display:none">Bot Servers</span>
                        <span class="es-text" style="display:none">Servidores del Bot</span>
                        <span class="fr-text" style="display:none">Serveurs du Bot</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="openTickets">-</div>
                    <div class="stat-label">
                        <span class="ar-text">تذاكر مفتوحة</span>
                        <span class="en-text" style="display:none">Open Tickets</span>
                        <span class="es-text" style="display:none">Tickets Abiertos</span>
                        <span class="fr-text" style="display:none">Tickets Ouverts</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="closedTickets">-</div>
                    <div class="stat-label">
                        <span class="ar-text">تذاكر مغلقة</span>
                        <span class="en-text" style="display:none">Closed Tickets</span>
                        <span class="es-text" style="display:none">Tickets Cerrados</span>
                        <span class="fr-text" style="display:none">Tickets Fermés</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==== السيرفرات ==== -->
        <div id="servers" class="tab-content">
            <h1 class="dashboard-title">
                <span class="ar-text">🌐 سيرفراتك</span>
                <span class="en-text" style="display:none">🌐 Your Servers</span>
                <span class="es-text" style="display:none">🌐 Tus Servidores</span>
                <span class="fr-text" style="display:none">🌐 Vos Serveurs</span>
            </h1>
            <p style="color:var(--text-muted);margin-bottom:1rem;">
                <span class="ar-text">اضغط على السيرفر عشان تسطبه</span>
                <span class="en-text" style="display:none">Click on the server to set it up</span>
                <span class="es-text" style="display:none">Haz clic en el servidor para configurarlo</span>
                <span class="fr-text" style="display:none">Cliquez sur le serveur pour le configurer</span>
            </p>
            <div id="serversList" class="servers-list">
                <p class="loading">⏳</p>
            </div>
        </div>

        <!-- ==== التذاكر ==== -->
        <div id="tickets" class="tab-content">
            <h1 class="dashboard-title">
                <span class="ar-text">🎫 التذاكر النشطة</span>
                <span class="en-text" style="display:none">🎫 Active Tickets</span>
                <span class="es-text" style="display:none">🎫 Tickets Activos</span>
                <span class="fr-text" style="display:none">🎫 Tickets Actifs</span>
            </h1>
            <div id="ticketsList" class="tickets-list">
                <p class="loading">⏳</p>
            </div>
        </div>

        <!-- ==== الاشتراك ==== -->
        <% if (botType === 'premium') { %>
        <div id="subscription" class="tab-content">
            <h1 class="dashboard-title">
                <span class="ar-text">💎 الاشتراك</span>
                <span class="en-text" style="display:none">💎 Subscription</span>
                <span class="es-text" style="display:none">💎 Suscripción</span>
                <span class="fr-text" style="display:none">💎 Abonnement</span>
            </h1>
            <div class="card">
                <p>
                    <span class="ar-text">استخدم الأمر <code>/my-subscription</code> في البوت لعرض اشتراكك.</span>
                    <span class="en-text" style="display:none">Use <code>/my-subscription</code> in the bot to view your subscription.</span>
                    <span class="es-text" style="display:none">Usa <code>/my-subscription</code> en el bot para ver tu suscripción.</span>
                    <span class="fr-text" style="display:none">Utilisez <code>/my-subscription</code> dans le bot pour voir votre abonnement.</span>
                </p>
            </div>
        </div>
        <% } %>
    </main>
</div>

<script src="/js/dashboard.js"></script>
<%- include('partials/footer') %>
