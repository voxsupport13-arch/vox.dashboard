<%- include('partials/header', { user, title: 'Reports' }) %>

<div class="container page-content">
    <div class="page-header">
        <h1>
            <span class="ar-text">🚨 الإبلاغ عن مشكلة</span>
            <span class="en-text" style="display:none">🚨 Report a Problem</span>
            <span class="es-text" style="display:none">🚨 Reportar un Problema</span>
            <span class="fr-text" style="display:none">🚨 Signaler un Problème</span>
        </h1>
        <p>
            <span class="ar-text">ساعدنا نحسن الخدمة — أبلغنا عن أي مشكلة</span>
            <span class="en-text" style="display:none">Help us improve — report any issue</span>
            <span class="es-text" style="display:none">Ayúdanos a mejorar — reporta cualquier problema</span>
            <span class="fr-text" style="display:none">Aidez-nous à nous améliorer — signalez tout problème</span>
        </p>
    </div>

    <div class="card report-form-card">
        <form id="reportForm" class="report-form">
            <div class="form-group">
                <label>
                    <span class="ar-text">نوع المشكلة</span>
                    <span class="en-text" style="display:none">Problem Type</span>
                    <span class="es-text" style="display:none">Tipo de Problema</span>
                    <span class="fr-text" style="display:none">Type de Problème</span>
                </label>
                <select name="type" required>
                    <option value="website">
                        🌐
                        <span class="ar-text">مشكلة في الموقع</span>
                        <span class="en-text" style="display:none">Website issue</span>
                        <span class="es-text" style="display:none">Problema en el sitio web</span>
                        <span class="fr-text" style="display:none">Problème de site web</span>
                    </option>
                    <option value="ticket">
                        🎫
                        <span class="ar-text">مشكلة في التذاكر</span>
                        <span class="en-text" style="display:none">Ticket issue</span>
                        <span class="es-text" style="display:none">Problema con tickets</span>
                        <span class="fr-text" style="display:none">Problème de ticket</span>
                    </option>
                    <option value="application">
                        📝
                        <span class="ar-text">مشكلة في التقديم</span>
                        <span class="en-text" style="display:none">Application issue</span>
                        <span class="es-text" style="display:none">Problema con solicitudes</span>
                        <span class="fr-text" style="display:none">Problème de candidature</span>
                    </option>
                    <option value="payment">
                        💰
                        <span class="ar-text">مشكلة في الدفع</span>
                        <span class="en-text" style="display:none">Payment issue</span>
                        <span class="es-text" style="display:none">Problema de pago</span>
                        <span class="fr-text" style="display:none">Problème de paiement</span>
                    </option>
                    <option value="other">
                        📌
                        <span class="ar-text">أخرى</span>
                        <span class="en-text" style="display:none">Other</span>
                        <span class="es-text" style="display:none">Otro</span>
                        <span class="fr-text" style="display:none">Autre</span>
                    </option>
                </select>
            </div>

            <div class="form-group">
                <label>
                    <span class="ar-text">عنوان المشكلة</span>
                    <span class="en-text" style="display:none">Problem Title</span>
                    <span class="es-text" style="display:none">Título del Problema</span>
                    <span class="fr-text" style="display:none">Titre du Problème</span>
                </label>
                <input type="text" name="title" placeholder="Title" required maxlength="100">
            </div>

            <div class="form-group">
                <label>
                    <span class="ar-text">تفاصيل المشكلة</span>
                    <span class="en-text" style="display:none">Problem Details</span>
                    <span class="es-text" style="display:none">Detalles del Problema</span>
                    <span class="fr-text" style="display:none">Détails du Problème</span>
                </label>
                <textarea name="description" rows="6" placeholder="..." required maxlength="2000"></textarea>
            </div>

            <div class="form-group">
                <label>
                    <span class="ar-text">صور (اختياري - رابط Imgur)</span>
                    <span class="en-text" style="display:none">Images (optional - Imgur link)</span>
                    <span class="es-text" style="display:none">Imágenes (opcional - enlace Imgur)</span>
                    <span class="fr-text" style="display:none">Images (optionnel - lien Imgur)</span>
                </label>
                <input type="url" name="imageUrl" placeholder="https://i.imgur.com/...">
            </div>

            <button type="submit" class="btn btn-primary btn-full">
                <span class="ar-text">🚨 إرسال الإبلاغ</span>
                <span class="en-text" style="display:none">🚨 Send Report</span>
                <span class="es-text" style="display:none">🚨 Enviar Reporte</span>
                <span class="fr-text" style="display:none">🚨 Envoyer le Signalement</span>
            </button>
        </form>
    </div>

    <div class="card">
        <h3>
            <span class="ar-text">📋 إبلاغاتك السابقة</span>
            <span class="en-text" style="display:none">📋 Your Previous Reports</span>
            <span class="es-text" style="display:none">📋 Tus Reportes Anteriores</span>
            <span class="fr-text" style="display:none">📋 Vos Signalements Précédents</span>
        </h3>
        <div id="myReports" class="my-reports">
            <p class="loading">⏳</p>
        </div>
    </div>
</div>

<script src="/js/reports.js"></script>
<%- include('partials/footer') %>
