<%- include('partials/header', { user, title: 'الرئيسية' }) %>

<section class="hero">
    <div class="hero-content">
        <div class="hero-badge">
            <span class="ar-text">✨ نظام تذاكر احترافي</span>
            <span class="en-text" style="display:none">✨ Professional Ticket System</span>
        </div>

        <h1 class="hero-title">
            <span class="gold-text">VOX</span>
            <span class="ar-text">نظام تذاكر متكامل</span>
            <span class="en-text" style="display:none">Complete Ticket System</span>
        </h1>

        <p class="hero-desc">
            <span class="ar-text">نظام تذاكر احترافي بمميزات متقدمة لإدارة سيرفرك بكل سهولة واحترافية. يدعم أكثر من قسم، تقييمات، إحصائيات، وتقديمات إدارية.</span>
            <span class="en-text" style="display:none">Professional ticket system with advanced features to manage your server easily. Supports multi-categories, ratings, statistics, and staff applications.</span>
        </p>

        <div class="hero-buttons">
            <a href="<%= freeBotInvite %>" target="_blank" class="btn btn-primary">
                <span class="ar-text">➕ إضافة البوت المجاني</span>
                <span class="en-text" style="display:none">➕ Add Free Bot</span>
            </a>
            <a href="/dashboard" class="btn btn-secondary">
                <span class="ar-text">🎛️ الداشبورد</span>
                <span class="en-text" style="display:none">🎛️ Dashboard</span>
            </a>
        </div>
    </div>
</section>

<section class="features-section">
    <div class="container">
        <h2 class="section-title">
            <span class="ar-text">🎯 مميزات البوت</span>
            <span class="en-text" style="display:none">🎯 Bot Features</span>
        </h2>

        <div class="features-grid">
            <div class="feature-card fade-in">
                <div class="feature-icon">🎫</div>
                <h3><span class="ar-text">نظام تذاكر متكامل</span><span class="en-text" style="display:none">Complete Ticket System</span></h3>
                <p><span class="ar-text">افتح تذاكر بسهولة مع دعم أكثر من قسم ولوحات متعددة.</span><span class="en-text" style="display:none">Open tickets easily with multi-category support.</span></p>
            </div>

            <div class="feature-card fade-in">
                <div class="feature-icon">⭐</div>
                <h3><span class="ar-text">نظام تقييمات</span><span class="en-text" style="display:none">Rating System</span></h3>
                <p><span class="ar-text">قيّم خدمة الفريق مع نظام نجوم متكامل ولوحة ترتيب الموظفين.</span><span class="en-text" style="display:none">Rate staff service with a complete star system.</span></p>
            </div>

            <div class="feature-card fade-in">
                <div class="feature-icon">📝</div>
                <h3><span class="ar-text">نظام تقديمات</span><span class="en-text" style="display:none">Application System</span></h3>
                <p><span class="ar-text">استقبل تقديمات إدارية بسهولة مع مراجعة تلقائية وقبول/رفض.</span><span class="en-text" style="display:none">Receive staff applications with auto review.</span></p>
            </div>

            <div class="feature-card fade-in">
                <div class="feature-icon">📊</div>
                <h3><span class="ar-text">إحصائيات متقدمة</span><span class="en-text" style="display:none">Advanced Statistics</span></h3>
                <p><span class="ar-text">تتبع أداء الفريق مع لوحة ترتيب وإحصائيات كاملة.</span><span class="en-text" style="display:none">Track staff performance with leaderboard.</span></p>
            </div>

            <div class="feature-card fade-in">
                <div class="feature-icon">🔒</div>
                <h3><span class="ar-text">حماية متقدمة</span><span class="en-text" style="display:none">Advanced Protection</span></h3>
                <p><span class="ar-text">حماية ضد السبام + قائمة حظر + صلاحيات دقيقة.</span><span class="en-text" style="display:none">Anti-spam + blacklist + precise permissions.</span></p>
            </div>

            <div class="feature-card fade-in">
                <div class="feature-icon">🌐</div>
                <h3><span class="ar-text">دعم عربي وإنجليزي</span><span class="en-text" style="display:none">Arabic & English</span></h3>
                <p><span class="ar-text">البوت يدعم اللغتين ويمكن تغيير اللغة لكل سيرفر.</span><span class="en-text" style="display:none">Bot supports both languages per server.</span></p>
            </div>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <div class="cta-box">
            <h2>
                <span class="ar-text">🚀 جاهز تبدأ؟</span>
                <span class="en-text" style="display:none">🚀 Ready to start?</span>
            </h2>
            <p>
                <span class="ar-text">أضف البوت المجاني الآن وابدأ في إدارة تذاكر سيرفرك باحترافية!</span>
                <span class="en-text" style="display:none">Add the free bot now and start managing your tickets professionally!</span>
            </p>
            <a href="<%= freeBotInvite %>" target="_blank" class="btn btn-primary">
                <span class="ar-text">➕ إضافة البوت الآن</span>
                <span class="en-text" style="display:none">➕ Add Bot Now</span>
            </a>
        </div>
    </div>
</section>

<%- include('partials/footer') %>