<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VOX | <%= (typeof title !== 'undefined' && title) ? title : 'Home' %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/images/favicon.png" type="image/png">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
    
    <!-- ✅ Apply saved language + flag immediately -->
    <script>
        (function() {
            const lang = localStorage.getItem('vox-lang') || 'en';
            document.documentElement.setAttribute('lang', lang);
            document.documentElement.setAttribute('dir', lang === 'ar' ? 'rtl' : 'ltr');
        })();

        document.addEventListener('DOMContentLoaded', function() {
            const lang = localStorage.getItem('vox-lang') || 'en';
            const flags = {
                en: 'https://flagcdn.com/w40/us.png',
                ar: 'https://flagcdn.com/w40/sa.png',
                es: 'https://flagcdn.com/w40/es.png',
                fr: 'https://flagcdn.com/w40/fr.png'
            };

            const flagEl = document.getElementById('currentLangFlag');
            if (flagEl && flags[lang]) {
                flagEl.src = flags[lang];
            }

            document.querySelectorAll('.lang-option').forEach(el => {
                el.classList.toggle('active', el.dataset.lang === lang);
            });
        });
    </script>
</head>
<body>

<nav class="navbar">
    <div class="nav-container">
        <a href="/" class="logo">
            <span class="logo-vox">VOX</span>
            <span class="logo-sub">TICKETS</span>
        </a>

        <div class="nav-links">
            <a href="/" class="nav-link">
                <span class="ar-text">الرئيسية</span>
                <span class="en-text" style="display:none">Home</span>
                <span class="es-text" style="display:none">Inicio</span>
                <span class="fr-text" style="display:none">Accueil</span>
            </a>
            <a href="/about" class="nav-link">
                <span class="ar-text">عن البوت</span>
                <span class="en-text" style="display:none">About</span>
                <span class="es-text" style="display:none">Acerca de</span>
                <span class="fr-text" style="display:none">À propos</span>
            </a>
            <a href="/commands" class="nav-link">
                <span class="ar-text">الأوامر</span>
                <span class="en-text" style="display:none">Commands</span>
                <span class="es-text" style="display:none">Comandos</span>
                <span class="fr-text" style="display:none">Commandes</span>
            </a>
            <a href="/pricing" class="nav-link">
                <span class="ar-text">الأسعار</span>
                <span class="en-text" style="display:none">Pricing</span>
                <span class="es-text" style="display:none">Precios</span>
                <span class="fr-text" style="display:none">Tarifs</span>
            </a>
            <a href="/reports" class="nav-link">
                <span class="ar-text">الإبلاغ</span>
                <span class="en-text" style="display:none">Report</span>
                <span class="es-text" style="display:none">Reportar</span>
                <span class="fr-text" style="display:none">Signaler</span>
            </a>
        </div>

        <div class="nav-actions">
            <button class="theme-toggle" onclick="toggleTheme()" title="Theme">
                <span class="theme-icon-light">☀️</span>
                <span class="theme-icon-dark">🌙</span>
            </button>

            <div class="lang-switch">
                <button class="lang-btn" onclick="toggleLangMenu(event)" title="Language">
                    <img 
                        id="currentLangFlag" 
                        src="https://flagcdn.com/w40/us.png" 
                        alt="flag"
                        class="lang-flag-img"
                    >
                </button>
                <div class="lang-dropdown" id="langDropdown">
                    <div class="lang-option" data-lang="en" onclick="chooseLang('en')">
                        <img src="https://flagcdn.com/w40/us.png" alt="US" class="lang-flag-img">
                    </div>
                    <div class="lang-option" data-lang="ar" onclick="chooseLang('ar')">
                        <img src="https://flagcdn.com/w40/sa.png" alt="SA" class="lang-flag-img">
                    </div>
                    <div class="lang-option" data-lang="es" onclick="chooseLang('es')">
                        <img src="https://flagcdn.com/w40/es.png" alt="ES" class="lang-flag-img">
                    </div>
                    <div class="lang-option" data-lang="fr" onclick="chooseLang('fr')">
                        <img src="https://flagcdn.com/w40/fr.png" alt="FR" class="lang-flag-img">
                    </div>
                </div>
            </div>

            <% if (typeof user !== 'undefined' && user) { %>
                <a href="/purchase" class="btn-login premium">
                    <span class="ar-text">💎 اشتراك</span>
                    <span class="en-text" style="display:none">💎 Subscribe</span>
                    <span class="es-text" style="display:none">💎 Suscribirse</span>
                    <span class="fr-text" style="display:none">💎 S'abonner</span>
                </a>
                <div class="user-menu">
                    <button class="user-avatar-btn" onclick="toggleUserMenu(event)">
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" alt="Avatar" class="user-avatar">
                    </button>
                    <div class="user-dropdown" id="userDropdown">
                        <span class="user-name"><%= user.username %></span>
                        <a href="/dashboard/<%= user.botType || 'free' %>" class="dropdown-link">
                            <span class="ar-text">لوحة التحكم</span>
                            <span class="en-text" style="display:none">Dashboard</span>
                            <span class="es-text" style="display:none">Panel</span>
                            <span class="fr-text" style="display:none">Tableau de bord</span>
                        </a>
                        <% if (typeof isOwner !== 'undefined' && isOwner) { %>
                            <a href="/owner" class="dropdown-link">
                                <span class="ar-text">لوحة الأونر</span>
                                <span class="en-text" style="display:none">Owner Panel</span>
                                <span class="es-text" style="display:none">Panel de Propietario</span>
                                <span class="fr-text" style="display:none">Panneau Propriétaire</span>
                            </a>
                        <% } %>
                        <a href="/logout" class="dropdown-link logout">
                            <span class="ar-text">تسجيل خروج</span>
                            <span class="en-text" style="display:none">Logout</span>
                            <span class="es-text" style="display:none">Cerrar sesión</span>
                            <span class="fr-text" style="display:none">Déconnexion</span>
                        </a>
                    </div>
                </div>
            <% } else { %>
                <a href="/auth/free" class="btn-login">
                    <span class="ar-text">الدخول</span>
                    <span class="en-text" style="display:none">Login</span>
                    <span class="es-text" style="display:none">Iniciar sesión</span>
                    <span class="fr-text" style="display:none">Connexion</span>
                </a>
            <% } %>
        </div>
    </div>
</nav>

<%- include('../news-ticker') %>
