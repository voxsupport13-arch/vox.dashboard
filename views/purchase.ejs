<%- include('partials/header', { user, title: 'Purchase' }) %>

<div class="container page-content">
    <div class="page-header">
        <h1>
            <span class="ar-text">💎 شراء VOX Premium</span>
            <span class="en-text" style="display:none">💎 Purchase VOX Premium</span>
            <span class="es-text" style="display:none">💎 Comprar VOX Premium</span>
            <span class="fr-text" style="display:none">💎 Acheter VOX Premium</span>
        </h1>
        <p>
            <span class="ar-text">أكمل عملية الشراء بالتفاصيل التالية</span>
            <span class="en-text" style="display:none">Complete your purchase with the following details</span>
            <span class="es-text" style="display:none">Completa tu compra con los siguientes detalles</span>
            <span class="fr-text" style="display:none">Complétez votre achat avec les détails suivants</span>
        </p>
    </div>

    <div class="purchase-container">
        <div class="purchase-box">
            <form id="purchaseForm" class="purchase-form">
                <div class="form-group">
                    <label>
                        <span class="ar-text">الباقة</span>
                        <span class="en-text" style="display:none">Plan</span>
                        <span class="es-text" style="display:none">Plan</span>
                        <span class="fr-text" style="display:none">Forfait</span>
                    </label>
                    <select name="plan" id="planSelect" required>
                        <option value="monthly">
                            <span class="ar-text">📅 شهري (30 يوم)</span>
                            <span class="en-text" style="display:none">📅 Monthly (30 days)</span>
                            <span class="es-text" style="display:none">📅 Mensual (30 días)</span>
                            <span class="fr-text" style="display:none">📅 Mensuel (30 jours)</span>
                        </option>
                        <option value="yearly">
                            <span class="ar-text">📅 سنوي (365 يوم)</span>
                            <span class="en-text" style="display:none">📅 Yearly (365 days)</span>
                            <span class="es-text" style="display:none">📅 Anual (365 días)</span>
                            <span class="fr-text" style="display:none">📅 Annuel (365 jours)</span>
                        </option>
                    </select>
                </div>

                <div class="form-group">
                    <label>
                        <span class="ar-text">طريقة الدفع</span>
                        <span class="en-text" style="display:none">Payment Method</span>
                        <span class="es-text" style="display:none">Método de Pago</span>
                        <span class="fr-text" style="display:none">Méthode de Paiement</span>
                    </label>
                    <select name="paymentMethod" id="paymentSelect" required>
                        <option value="credit">💰 Credit Pro</option>
                        <option value="adm_cash">💵 ADM Cash</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>
                        <span class="ar-text">السيرفر المستهدف</span>
                        <span class="en-text" style="display:none">Target Server</span>
                        <span class="es-text" style="display:none">Servidor Objetivo</span>
                        <span class="fr-text" style="display:none">Serveur Cible</span>
                    </label>
                    <select name="guildId" id="guildSelect" required>
                        <option value="">
                            -- اختر السيرفر --
                        </option>
                    </select>
                    <input type="hidden" name="guildName" id="guildName">
                </div>

                <div class="form-group">
                    <button type="button" id="hasCouponBtn" class="btn btn-secondary btn-full" onclick="showCouponInput()">
                        <span class="ar-text">🎟️ هل تملك كود خصم؟</span>
                        <span class="en-text" style="display:none">🎟️ Do you have a coupon?</span>
                        <span class="es-text" style="display:none">🎟️ ¿Tienes un cupón?</span>
                        <span class="fr-text" style="display:none">🎟️ Avez-vous un coupon ?</span>
                    </button>
                </div>

                <div class="form-group" id="couponBox" style="display:none;">
                    <label>
                        <span class="ar-text">كود الخصم</span>
                        <span class="en-text" style="display:none">Coupon Code</span>
                        <span class="es-text" style="display:none">Código del Cupón</span>
                        <span class="fr-text" style="display:none">Code du Coupon</span>
                    </label>
                    <div style="display:flex;gap:0.5rem;">
                        <input type="text" name="couponCode" id="couponInput" placeholder="VOX50" style="flex:1;">
                        <button type="button" onclick="validateCoupon()" class="btn btn-primary">
                            <span class="ar-text">تطبيق</span>
                            <span class="en-text" style="display:none">Apply</span>
                            <span class="es-text" style="display:none">Aplicar</span>
                            <span class="fr-text" style="display:none">Appliquer</span>
                        </button>
                    </div>
                    <div id="couponResult"></div>
                </div>

                <div class="form-group">
                    <label>
                        <span class="ar-text">يوزر التحويل (ADM/ Credit)</span>
                        <span class="en-text" style="display:none">Transfer User (ADM/Credit)</span>
                        <span class="es-text" style="display:none">Usuario de Transferencia (ADM/Credit)</span>
                        <span class="fr-text" style="display:none">Utilisateur de Transfert (ADM/Credit)</span>
                    </label>
                    <input type="text" name="transferUser" placeholder="username" required>
                    <small style="color:var(--text-muted);display:block;margin-top:0.5rem;">
                        <span class="ar-text">⚠️ يجب أن يكون التحويل على: <code>abd8</code></span>
                        <span class="en-text" style="display:none">⚠️ Transfer must be to: <code>abd8</code></span>
                        <span class="es-text" style="display:none">⚠️ La transferencia debe ser a: <code>abd8</code></span>
                        <span class="fr-text" style="display:none">⚠️ Le transfert doit être à : <code>abd8</code></span>
                    </small>
                </div>

                <div class="form-group">
                    <label>
                        <span class="ar-text">رابط صورة الإثبات (اختياري)</span>
                        <span class="en-text" style="display:none">Proof Image URL (Optional)</span>
                        <span class="es-text" style="display:none">URL de la Imagen de Prueba (Opcional)</span>
                        <span class="fr-text" style="display:none">URL de l'Image de Preuve (Optionnel)</span>
                    </label>
                    <input type="url" name="proofImage" placeholder="https://i.imgur.com/...">
                </div>

                <div class="payment-note" style="margin-bottom:1.5rem;">
                    <p>
                        ⚠️
                        <span class="ar-text">بعد الدفع، اكتب اليوزر اللي حولت له. سيتم مراجعة الطلب وإرسال المفتاح لك بعد الموافقة.</span>
                        <span class="en-text" style="display:none">After payment, enter the transfer user. Your request will be reviewed and the key sent after approval.</span>
                        <span class="es-text" style="display:none">Después del pago, introduce el usuario de transferencia. Tu solicitud será revisada y la clave enviada tras la aprobación.</span>
                        <span class="fr-text" style="display:none">Après le paiement, entrez l'utilisateur de transfert. Votre demande sera examinée et la clé envoyée après approbation.</span>
                    </p>
                </div>

                <button type="submit" class="btn btn-primary btn-full">
                    <span class="ar-text">💳 إرسال طلب الشراء</span>
                    <span class="en-text" style="display:none">💳 Submit Purchase Request</span>
                    <span class="es-text" style="display:none">💳 Enviar Solicitud de Compra</span>
                    <span class="fr-text" style="display:none">💳 Soumettre la Demande d'Achat</span>
                </button>
            </form>
        </div>
    </div>
</div>

<script src="/js/purchase.js"></script>
<%- include('partials/footer') %>
